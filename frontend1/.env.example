# Optional frontend overrides.
# In local dev, Vite proxy already routes /api/* to http://127.0.0.1:8001.

# Set this only when frontend is hosted separately from backend.
# VITE_TOKEN_API_URL=https://your-backend-domain

# Frame sampling cadence while screen share is enabled.
# Recommended: 3 to 5 seconds for cost control.
VITE_SCREEN_CAPTURE_INTERVAL_SECONDS=4

# Optional frame resizing before upload. Lower values reduce OCR latency/cost.
VITE_SCREEN_CAPTURE_MAX_WIDTH=1280
VITE_SCREEN_CAPTURE_JPEG_QUALITY=0.68

# Optional mic suppression window after assistant audio playback to avoid echo loops.
VITE_SONIC_PLAYBACK_MIC_SUPPRESSION_MS=450
